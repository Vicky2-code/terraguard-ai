# TerraGuard AI — backend environment variables
# Copy to backend/.env and adjust. NEVER commit the real .env file.

# --- Database ---------------------------------------------------------------
# SQLite (local dev default):
DATABASE_URL=sqlite:///./terraguard.db
# Managed Postgres (production):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/terraguard

# --- Auth -------------------------------------------------------------------
# REQUIRED in production: generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS -------------------------------------------------------------------
# Comma separated (or JSON array) of allowed browser origins.
# Leave unset for the localhost dev defaults (5173/5174/4173).
# Production example:
# CORS_ORIGINS=https://terraguard-ai.vercel.app
CORS_ORIGINS=

# --- Weather ingestion (Open-Meteo, keyless, server-side only) --------------
# 1 = live Open-Meteo calls (default). 0 = deterministic fallback (tests/CI).
TERRAGUARD_LIVE_WEATHER=1
WEATHER_TIMEOUT_SECONDS=12
