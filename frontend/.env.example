# TerraGuard AI — frontend environment variables
#
# Base URL of the FastAPI backend. Leave empty ("") to use same-origin
# (/api proxied by the dev server in local development, or by your host in
# production). Set an absolute URL for a separately deployed backend, e.g.
#
#   VITE_API_BASE_URL=https://terraguard-api.example.com
#
# In Vercel: Project Settings → Environment Variables → add VITE_API_BASE_URL.
VITE_API_BASE_URL=
